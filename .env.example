# Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key

# High-Availability & Resilience Model Configuration (Optional)
# Defaults: PRIMARY_GEMINI_MODEL=gemini-3.8-flash, FALLBACK_GEMINI_MODEL=gemini-3.5-flash-lite
PRIMARY_GEMINI_MODEL=gemini-3.8-flash
FALLBACK_GEMINI_MODEL=gemini-3.5-flash-lite